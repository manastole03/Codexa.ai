# ─────────────────────────────────────────────────────────────
# Codexa.ai — example environment. Copy to `.env` and fill in.
# `.env` is git-ignored. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# ─── Web (Next.js) ────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
# Required in production — boot will fail without it.
AUTH_SECRET=replace-with-openssl-rand-base64-32
GITHUB_ID=
GITHUB_SECRET=
NEXT_PUBLIC_API_URL=http://localhost:4000

# ─── API + Executor ───────────────────────────────────────────
API_PORT=4000
MCP_HTTP_PORT=5050
DATABASE_URL=postgresql://arena:arena@localhost:5432/arena?schema=public
REDIS_URL=redis://localhost:6379

# Comma-separated origin allowlist for the API server (HTTP + Socket.IO).
# Required in production. Wildcard "*" is rejected in production.
# Example: CORS_ORIGINS=https://app.codexa.ai,https://staging.codexa.ai
CORS_ORIGINS=http://localhost:3000

# Number of reverse proxies in front of the API (1 for most managed platforms,
# 0 if hit directly). Affects req.ip and rate-limit accuracy.
TRUST_PROXY=0

# ─── Docker sandbox limits ────────────────────────────────────
EXECUTOR_WALL_TIMEOUT_MS=5000
EXECUTOR_MEMORY_MB=256
EXECUTOR_CPU_COUNT=1

# ─── AI provider (OpenRouter / compatible) ────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
# Optional — sent as HTTP-Referer / X-Title for OpenRouter analytics.
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=
# Generic fallback if not using OpenRouter:
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=
