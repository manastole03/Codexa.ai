{
  "name": "codexa-ai",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rimraf node_modules",
    "docker:up": "docker compose up -d postgres redis",
    "docker:down": "docker compose down",
    "docker:build-execs": "docker compose --profile executor-build build arena-node arena-python arena-cpp",
    "db:push": "pnpm --filter @codexa/db db:push",
    "db:seed": "pnpm --filter @codexa/db db:seed",
    "dev:web": "pnpm --filter @codexa/web dev",
    "dev:api": "pnpm --filter @codexa/api dev",
    "dev:executor": "pnpm --filter @codexa/executor dev",
    "dev:mcp": "pnpm --filter @codexa/mcp dev"
  },
  "devDependencies": {
    "@types/node": "^20.17.14",
    "eslint": "^8.57.1",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
